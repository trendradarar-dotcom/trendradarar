FROM python@sha256:f21c0d5a44c56805654c15abccc1b2fd576c8d93aca0a3f74b4aba2dc92510e2

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY wheelhouse/ /wheelhouse/
COPY source/instagram_oauth_service/requirements.txt /tmp/service-requirements.txt
COPY source/instagram_oauth_gateway/requirements.txt /tmp/gateway-requirements.txt

RUN python --version && \
    test "$(python -c 'import platform; print(platform.python_version())')" = "3.14.3" && \
    python -m pip install --no-index --find-links=/wheelhouse --no-compile \
      -r /tmp/service-requirements.txt \
      -r /tmp/gateway-requirements.txt && \
    python -m pip check && \
    rm -rf /wheelhouse /root/.cache/pip

COPY source/ /app/

CMD ["python", "-c", "import platform; print(platform.python_version())"]
